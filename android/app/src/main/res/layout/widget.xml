<?xml version="1.0" encoding="utf-8"?>
<!--
  Only views on the RemoteViews allowlist appear here: FrameLayout, ImageView
  and TextView. Space and View are not on it, so the top/bottom split is done
  with layout_gravity.

  Every TextView ships a default value. Before the first successful update, and
  after a failed one, the widget shows a dash rather than empty space, so it can
  never look broken without saying so.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_scene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/widget_scene_description" />

    <TextView
        android:id="@+id/widget_session"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="31dp"
        android:textColor="#7BE6C0"
        android:textSize="11sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:visibility="gone"
        android:shadowColor="#99000000"
        android:shadowRadius="4" />

    <TextView
        android:id="@+id/widget_place"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:text="@string/widget_placeholder"
        android:textColor="#E6F3F6"
        android:textSize="13sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:shadowColor="#99000000"
        android:shadowRadius="4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/widget_temp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="5" />

        <TextView
            android:id="@+id/widget_sea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="2dp"
            android:text="@string/widget_placeholder"
            android:textColor="#F2FAFC"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowRadius="4" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="@string/widget_no_reading"
            android:textColor="#C6D9E0"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:shadowColor="#99000000"
            android:shadowRadius="3" />
    </LinearLayout>
</FrameLayout>
